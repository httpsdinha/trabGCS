# Configurações do Banco de Dados - Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/seu_banco
SPRING_DATASOURCE_USERNAME=seu_usuario
SPRING_DATASOURCE_PASSWORD=sua_senha

# Configurações do Banco de Dados - JPA/Persistence
JPA_DATABASE_URL=jdbc:postgresql://localhost:5432/seu_banco_local
JPA_DATABASE_USERNAME=seu_usuario_local
JPA_DATABASE_PASSWORD=sua_senha_local

# Configurações da Aplicação
SERVER_PORT=8080

# Configurações de CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001
